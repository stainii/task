# The shape of the production environment (#24, ADR-0007 / ADR-0010). Copy to production.env
# ON THE BOX ONLY, fill it in, and `chmod 600` it.
#
#     cp deploy/production.example.env deploy/production.env && chmod 600 deploy/production.env
#
# production.env is gitignored and is the only place production configuration exists. It is also,
# per ADR-0008, one of the three things in the nightly archive — the other two being the compose
# file beside this one and the pg_dumpall — which is what makes a restored archive enough to put a
# rebuilt box back on the internet.
#
# THERE IS NO CLIENT SECRET IN THIS FILE, and that is not an omission. The back-end is a resource
# server: it validates JWTs against the issuer and holds no credential, and every Keycloak client
# here is public (#31). The VAPID private key is ours rather than issued to us, and authenticates
# nothing to Keycloak.

# --- Postgres -----------------------------------------------------------------------------------
# The application's database, and the credentials Keycloak reuses for its own (ADR-0008 puts both
# in one instance). Set before the first `up`: they are read only when the data directory is empty.
POSTGRES_DB=task
POSTGRES_USER=task
POSTGRES_PASSWORD=
KEYCLOAK_DB=keycloak

# --- Keycloak -----------------------------------------------------------------------------------
# Pinned, not derived: a login through the LAN address would otherwise mint tokens whose `iss` the
# back-end rejects.
KEYCLOAK_HOSTNAME=https://task.stijnhooft.be
# The LAN URL, so the admin console's own links work. Same port as KEYCLOAK_ADMIN_PORT below.
KEYCLOAK_HOSTNAME_ADMIN=http://192.168.0.116:8082
# The one published host port in the whole stack. There is no port-forwarding on this network, so
# this is the house and nowhere else — which is the point (ADR-0010).
KEYCLOAK_ADMIN_PORT=8082
# Bootstrap admin. Keycloak 26 ignores the older KEYCLOAK_ADMIN/KEYCLOAK_ADMIN_PASSWORD names
# entirely. Only read while the Keycloak database is empty; afterwards the account is in the
# database and this pair does nothing.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=

# What the back-end validates tokens against, and what a cold client is told by GET /api/config.
# The realm is shared infrastructure named after its owner; `task` is one client in it (ADR-0010).
KEYCLOAK_ISSUER_URI=https://task.stijnhooft.be/realms/stijnhooft-realm

# Where the back-end fetches Keycloak's signing keys: over the Docker network, not out through the
# tunnel and back. The realm here must match the one in KEYCLOAK_ISSUER_URI above — see the comment
# in compose.yaml for why this is the one pair of values allowed to be configured separately.
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/stijnhooft-realm/protocol/openid-connect/certs

# --- Web Push (ADR-0012) ------------------------------------------------------------------------
# Generate once, then never lose: a new pair invalidates every existing subscription. Keep a copy
# outside the box — the nightly archive carries this file, but the archive is what you are
# restoring FROM.
#
#     npx web-push generate-vapid-keys
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:stijnhooft@hotmail.com

# --- Cloudflare ---------------------------------------------------------------------------------
# The tunnel's token, from the Cloudflare dashboard. This is what publishes nginx — and what makes
# a rebuilt box reachable again. Losing it is the thing that strands a restore, not a certificate.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Version ------------------------------------------------------------------------------------
# LEAVE THIS UNSET IN NORMAL OPERATION. deploy.sh derives the image tag from the commit it has just
# pulled, so the box runs the code it checked out. Setting it PINS the stack to one version and
# stops the nightly deploy moving it — which is exactly what a rollback is. See
# docs/operating-manual.md, "Deploy and rollback".
#TASK_VERSION=
