# Installed by SYMLINK, never copied — see docs/operating-manual.md:
#
#     sudo systemctl link /home/stijn/task/deploy/systemd/task-deploy.service
#     sudo systemctl enable --now /home/stijn/task/deploy/systemd/task-deploy.timer
#
# So this file has one copy, it is this one, and `git pull` is how the schedule changes. A copy in
# /etc/systemd/system would be a second source of truth that nothing keeps in step and that the
# nightly archive would have to be taught to carry.

[Unit]
Description=task: back up, pull, deploy (ADR-0007, one unit and in this order)
Documentation=https://github.com/stainii/task/blob/main/docs/operating-manual.md
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=stijn
WorkingDirectory=/home/stijn/task
ExecStart=/home/stijn/task/deploy/deploy.sh
# The verification restore starts a throwaway Postgres and waits for it; the deploy then waits for
# the back-end's healthcheck. Neither is fast, and a timeout that fires mid-restore would leave a
# half-loaded scratch container behind for no reason.
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
