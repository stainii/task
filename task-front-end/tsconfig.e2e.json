/* The Playwright suite (#64). It runs outside the Angular build — Playwright transpiles it itself —
   so this exists to give an editor and `tsc` the same view of it that the runner has. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/e2e",
    "types": ["node"],
    /* The harness is `.mjs`, so without these two its JSDoc `@param` types are decorative and `tsc`
       never opens the file at all. `e2e/stack.mjs` and `e2e/serve.mjs` are 350 lines of the thing
       that brings the real stack up; they are not exempt from being checked. */
    "allowJs": true,
    "checkJs": true
  },
  "include": ["e2e/**/*.ts", "e2e/**/*.mjs", "playwright.config.ts"]
}
