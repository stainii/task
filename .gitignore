# Local HTTP client credentials (dev-only, keep out of the public repo)
task-back-end/http-requests/http-client.env.json

# Production configuration. This repo is public by choice (#31): committed config
# holds dev-only values, and production values reach the server as environment,
# never as a file in git.
.env
*.env
!*.example.env

# Installed agent skills (Angular's own, pinned in skills-lock.json). They are
# vendored third-party content, reinstallable from the lock file, so they stay
# out of the repo.
.agents/skills/
.claude/skills/

# OS
.DS_Store
Thumbs.db

# ADR-0009: logs are written to a volume in production, and to ./logs when run locally.
logs/
